{"parse":{"title":"Through Darkness Led by Moonlight","pageid":430082,"revid":2048941,"redirects":[],"text":"<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-default\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">Through Darkness Led by Moonlight</h2>\n\n<figure class=\"pi-item pi-image\" data-source=\"image\">\n\t<a href=\"https://static.wikia.nocookie.net/gensin-impact/images/7/7e/Constellation_Through_Darkness_Led_by_Moonlight.png/revision/latest?cb=20260114205646\" class=\"image image-thumbnail\" title=\"Constellation Through Darkness Led by Moonlight\">\n\t\t<img src=\"https://static.wikia.nocookie.net/gensin-impact/images/7/7e/Constellation_Through_Darkness_Led_by_Moonlight.png/revision/latest?cb=20260114205646\" srcset=\"https://static.wikia.nocookie.net/gensin-impact/images/7/7e/Constellation_Through_Darkness_Led_by_Moonlight.png/revision/latest?cb=20260114205646 1x, https://static.wikia.nocookie.net/gensin-impact/images/7/7e/Constellation_Through_Darkness_Led_by_Moonlight.png/revision/latest?cb=20260114205646 2x\" class=\"pi-image-thumbnail\" data-relevant=\"1\" alt=\"Constellation Through Darkness Led by Moonlight\" width=\"128\" height=\"128\" data-image-key=\"Constellation_Through_Darkness_Led_by_Moonlight.png\" data-image-name=\"Constellation Through Darkness Led by Moonlight.png\" />\n\t\t\n\t</a>\n\t\n</figure>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"character\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Char­ac­ter</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Columbina\" title=\"Columbina\">Columbina</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"level\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Level</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">6</div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"level\">Previous</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"level\">Next</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"level\"><a href=\"/wiki/Silence_Tending_One_Lone_Song\" title=\"Silence Tending One Lone Song\">Silence Tending One Lone Song</a></td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"level\">-</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tDescription\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tDetails\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"description\">\n\t\n\t<div class=\"pi-data-value pi-font\">For 8s after characters in the <span class=\"custom-tt-wrapper giw-extra-effect-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed giw-collapsible\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-default mw-collapsible-toggle-collapsed giw-extra-effect toggle-tooltip\"><b>Lunar Domain</b></span><span class=\"mw-collapsible-content giw-extra-effect\" style=\"display:none\"><span class=\"giw-extra-effect-header\">Lunar Domain</span><span class=\"giw-extra-effect-content\"> The domain that Columbina summons after unleashing the Elemental Burst Moonlit Melancholy.<br />When current active characters are within the Lunar Domain, Lunar Reaction DMG inflicted by all party members will increase.</span></span></span> trigger a Lunar reaction, based on the elements involved in the reaction, the <a href=\"/wiki/CRIT_DMG\" title=\"CRIT DMG\">CRIT DMG</a> of the corresponding Elemental DMG done by all <a href=\"/wiki/Party\" title=\"Party\">party</a> members is increased by 80%. The CRIT DMG-increasing effects for the same Elemental Type do not stack.<br /><br />All nearby party members' Lunar Reaction DMG is <span class=\"custom-tt-wrapper giw-extra-effect-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed giw-collapsible\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-default mw-collapsible-toggle-collapsed giw-extra-effect toggle-tooltip\"><b>elevated</b></span><span class=\"mw-collapsible-content giw-extra-effect\" style=\"display:none\"><span class=\"giw-extra-effect-header\">Elevation</span><span class=\"giw-extra-effect-content\">Special DMG Boost effect. It is calculated independently of other DMG Boost effects.</span></span></span> by 7%.</div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"utility1\">\n\t\n\t<div class=\"pi-data-value pi-font\"><b>Utility</b><ul><li><a href=\"/wiki/CRIT_DMG\" title=\"CRIT DMG\">CRIT DMG</a></li><li><a href=\"/wiki/Lunar-Charged_DMG_Elevation\" class=\"mw-redirect\" title=\"Lunar-Charged DMG Elevation\">Lunar-Charged DMG Elevation</a></li><li><a href=\"/wiki/Lunar-Bloom_DMG_Elevation\" class=\"mw-redirect\" title=\"Lunar-Bloom DMG Elevation\">Lunar-Bloom DMG Elevation</a></li><li><a href=\"/wiki/Lunar-Crystallize_DMG_Elevation\" class=\"mw-redirect\" title=\"Lunar-Crystallize DMG Elevation\">Lunar-Crystallize DMG Elevation</a></li><li><a href=\"/wiki/DMG_Elevation\" class=\"mw-redirect\" title=\"DMG Elevation\">DMG Elevation</a></li></ul></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n\n<b>Through Darkness Led by Moonlight</b> is <a href=\"/wiki/Columbina\" title=\"Columbina\">Columbina</a>'s <a href=\"/wiki/Level_6_Constellation\" class=\"mw-redirect\" title=\"Level 6 Constellation\">Level 6 Constellation</a>.\n<p class=\"mw-empty-elt\"></p>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fgenshin-impact.fandom.com%2Fwiki%2FThrough_Darkness_Led_by_Moonlight%3Fveaction%3Dedit%26section%3D1&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table\">\n<tbody><tr><th>Language</th><th>Official Name</th><th>Literal Meaning</th></tr><tr><td><b>English</b></td><td>Through Darkness Led by Moonlight</td><td>&#8212;</td></tr><tr><td><b>Chinese<br /><small>(Simplified)</small></b></td><td><span lang=\"zh-Hans\">夜昏且暗，且随月光</span><br /><small><i><span lang=\"zh-rm\">Yè Hūn Qiě Àn, Qiě Suí Yuèguāng</span></i></small></td><td rowspan=\"2\">The Night Is Dim and Dark, and Follows the Moonlight</td></tr><tr><td><b>Chinese<br /><small>(Traditional)</small></b></td><td><span lang=\"zh-Hant\">夜昏且暗，且隨月光</span><br /><small><i><span lang=\"zh-rm\">Yè Hūn Qiě Àn, Qiě Suí Yuèguāng</span></i></small></td></tr><tr><td><b>Japanese</b></td><td><span lang=\"ja\">暗き夜の月と共に往く道</span></td><td></td></tr><tr><td><b>Korean</b></td><td><span lang=\"ko\">어두운</span> <span lang=\"ko\">밤</span> <span lang=\"ko\">달빛의</span> <span lang=\"ko\">인도</span><br /><small><i>Eoduun Bam Dalbichui Indo</i></small></td><td></td></tr><tr><td><b>Spanish</b></td><td>A trav<span lang=\"es\">é</span>s de la oscuridad, sigue la luz lunar</td><td></td></tr><tr><td><b>French</b></td><td>Nuit lugubre, lune <span lang=\"fr\">à</span> travers</td><td>Gloomy Night, Moon Across</td></tr><tr><td><b>Russian</b></td><td><span lang=\"ru\">Сквозь</span> <span lang=\"ru\">тьму</span> <span lang=\"ru\">за</span> <span lang=\"ru\">лунным</span> <span lang=\"ru\">светом</span><br /><small><i>Skvoz' t'mu za lunnym svetom</i></small></td><td></td></tr><tr><td><b>Thai</b></td><td>Through Darkness Led by Moonlight</td><td>&#8212;</td></tr><tr><td><b>Vietnamese</b></td><td><span lang=\"vi\">Đêm Đen U Tối, Theo Chân Ánh Trăng</span></td><td></td></tr><tr><td><b>German</b></td><td>Durch die Dunkelheit, gef<span lang=\"de\">ü</span>hrt vom Mondlicht</td><td>Through the Darkness, Led by Moonlight</td></tr><tr><td><b>Indonesian</b></td><td>Through Darkness Led by Moonlight</td><td>&#8212;</td></tr><tr><td><b>Portuguese</b></td><td>Atravessando a Escurid<span lang=\"pt\">ã</span>o com o Luar</td><td></td></tr><tr><td><b>Turkish</b></td><td>Ay I<span lang=\"tr\">şığı</span>nda Karanl<span lang=\"tr\">ığı</span>n <span lang=\"tr\">İç</span>inden</td><td></td></tr><tr><td><b>Italian</b></td><td>Attraverso le tenebre, guidati dal chiaro di luna</td><td></td></tr></tbody></table>\n<h2><span class=\"mw-headline\" id=\"Change_History\">Change History</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\