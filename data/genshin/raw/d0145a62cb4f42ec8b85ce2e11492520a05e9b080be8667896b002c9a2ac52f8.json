-list navbox-odd\"><div style=\"padding:0em 0.25em\">\n<table width=\"100%\" style=\"table-layout: fixed; vertical-align: top;\">\n<tbody><tr style=\"vertical-align: top;\">\n<td style=\"vertical-align: top;\"><small>Normal </small><br /><b>Attack</b><br /><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"/wiki/Vila_Blade_Dance\" title=\"Vila Blade Dance\"><img alt=\"Sword Anemo\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"60\" height=\"60\" class=\"mw-file-element lazyload\" data-image-name=\"Sword Anemo.png\" data-image-key=\"Sword_Anemo.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/gensin-impact/images/0/04/Sword_Anemo.png/revision/latest/scale-to-width-down/60?cb=20210607090054\" /></a></span><br /><a href=\"/wiki/Vila_Blade_Dance\" title=\"Vila Blade Dance\">Vila Blade Dance</a></td><td style=\"vertical-align: top;\"><small>Elemental </small><br /><b>Skill</b><br /><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"/wiki/The_Art_of_Victory\" title=\"The Art of Victory\"><img alt=\"Talent The Art of Victory\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"60\" height=\"60\" class=\"mw-file-element lazyload\" data-image-name=\"Talent The Art of Victory.png\" data-image-key=\"Talent_The_Art_of_Victory.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/gensin-impact/images/7/7b/Talent_The_Art_of_Victory.png/revision/latest/scale-to-width-down/60?cb=20260928031035\" /></a></span><br /><a href=\"/wiki/The_Art_of_Victory\" title=\"The Art of Victory\">The Art of Victory</a></td><td style=\"vertical-align: top;\"><small>Elemental </small><br /><b>Burst</b><br /><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"/wiki/For_the_Tsaritsa!\" title=\"For the Tsaritsa!\"><img alt=\"Talent For the Tsaritsa!\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"60\" height=\"60\" class=\"mw-file-element lazyload\" data-image-name=\"Talent For the Tsaritsa!.png\" data-image-key=\"Talent_For_the_Tsaritsa%21.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/gensin-impact/images/0/04/Talent_For_the_Tsaritsa%21.png/revision/latest/scale-to-width-down/60?cb=20260928031037\" /></a></span><br /><a href=\"/wiki/For_the_Tsaritsa!\" title=\"For the Tsaritsa!\">For the Tsaritsa!</a></td><td style=\"vertical-align: top;\"><small>1st Ascension </small><br /><b>Passive</b><br /><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"/wiki/Rite_of_Spring%27s_Procession\" title=\"Rite of Spring&#39;s Procession\"><img alt=\"Talent Rite of Spring&#39;s Procession\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"60\" height=\"60\" class=\"mw-file-element lazyload\" data-image-name=\"Talent Rite of Spring&#39;s Procession.png\" data-image-key=\"Talent_Rite_of_Spring%27s_Procession.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/gensin-impact/images/b/b4/Talent_Rite_of_Spring%27s_Procession.png/revision/latest/scale-to-width-down/60?cb=20260928031038\" /></a></span><br /><a href=\"/wiki/Rite_of_Spring%27s_Procession\" title=\"Rite of Spring&#39;s Procession\">Rite of Spring's Procession</a></td><td style=\"vertical-align: top;\"><small>4th Ascension </small><br /><b>Passive</b><br /><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"/wiki/Truth_Prevails\" title=\"Truth Prevails\"><img alt=\"Talent Truth Prevails\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"60\" height=\"60\" class=\"mw-file-element lazyload\" data-image-name=\"Talent Truth Prevails.png\" data-image-key=\"T