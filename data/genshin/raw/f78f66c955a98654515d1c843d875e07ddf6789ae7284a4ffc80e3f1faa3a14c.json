{"parse":{"title":"Expert Instinct","pageid":451319,"revid":2141032,"redirects":[],"text":"<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p class=\"mw-empty-elt\">\n</p><aside role=\"region\" class=\"portable-infobox pi-background pi-border-color pi-theme-wikia pi-layout-default\">\n<h2 class=\"pi-item pi-item-spacing pi-title pi-secondary-background\" data-source=\"title\">Expert Instinct</h2>\n\n<figure class=\"pi-item pi-image\" data-source=\"image\">\n\t<a href=\"https://static.wikia.nocookie.net/gensin-impact/images/9/99/Constellation_Expert_Instinct.png/revision/latest?cb=20260408033837\" class=\"image image-thumbnail\" title=\"Constellation Expert Instinct\">\n\t\t<img src=\"https://static.wikia.nocookie.net/gensin-impact/images/9/99/Constellation_Expert_Instinct.png/revision/latest?cb=20260408033837\" srcset=\"https://static.wikia.nocookie.net/gensin-impact/images/9/99/Constellation_Expert_Instinct.png/revision/latest?cb=20260408033837 1x, https://static.wikia.nocookie.net/gensin-impact/images/9/99/Constellation_Expert_Instinct.png/revision/latest?cb=20260408033837 2x\" class=\"pi-image-thumbnail\" data-relevant=\"1\" alt=\"Constellation Expert Instinct\" width=\"128\" height=\"128\" data-image-key=\"Constellation_Expert_Instinct.png\" data-image-name=\"Constellation Expert Instinct.png\" />\n\t\t\n\t</a>\n\t\n</figure>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"character\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Char­ac­ter</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Linnea\" title=\"Linnea\">Linnea</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"level\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Level</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">4</div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\