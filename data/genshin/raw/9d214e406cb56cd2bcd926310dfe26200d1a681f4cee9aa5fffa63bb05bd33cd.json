;;;\" class=\"navbox-list navbox-odd\"><div style=\"padding:0em 0.25em\">\n<table width=\"100%\" style=\"table-layout: fixed; vertical-align: top;\">\n<tbody><tr style=\"vertical-align: top;\">\n<td style=\"vertical-align: top;\"><small>Normal </small><br /><b>Attack</b><br /><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"/wiki/Formule_Phenomenale:_Self-Evident_Proposition\" title=\"Formule Phenomenale: Self-Evident Proposition\"><img alt=\"Claymore Cryo\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"60\" height=\"60\" class=\"mw-file-element lazyload\" data-image-name=\"Claymore Cryo.png\" data-image-key=\"Claymore_Cryo.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/gensin-impact/images/9/99/Claymore_Cryo.png/revision/latest/scale-to-width-down/60?cb=20210607085530\" /></a></span><br /><a href=\"/wiki/Formule_Phenomenale:_Self-Evident_Proposition\" title=\"Formule Phenomenale: Self-Evident Proposition\">Formule Phenomenale: Self-Evident Proposition</a></td><td style=\"vertical-align: top;\"><small>Elemental </small><br /><b>Skill</b><br /><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"/wiki/Formule_Phenomenale:_Differential_Analysis\" title=\"Formule Phenomenale: Differential Analysis\"><img alt=\"Talent Formule Phenomenale Differential Analysis\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" decoding=\"async\" loading=\"lazy\" width=\"60\" height=\"60\" class=\"mw-file-element lazyload\" data-image-name=\"Talent Formule Phenomenale Differential Analysis.png\" data-image-key=\"Talent_Formule_Phenomenale_Differential_Analysis.png\" data-relevant=\"0\" data-src=\"https://static.wikia.nocookie.net/gensin-impact/images/e/e0/Talent_Formule_Phenomenale_Differential_Analysis.png/revision/latest/scale-to-width-down/60?cb=20260701121944\" /></a></span><br /><a href=\"/wiki/Formule_P