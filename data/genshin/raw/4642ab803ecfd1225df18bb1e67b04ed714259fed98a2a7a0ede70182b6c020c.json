lor\" data-source=\"level\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Level</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">4</div>\n</div>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<table class=\"pi-horizontal-group\">\n\t\n\t\n\t<thead>\n\t\t<tr>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"level\">Previous</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"level\">Next</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"level\"><a href=\"/wiki/%22Seek_Not_to_Tread_the_Sly_Fox%27s_Path%22\" title=\"&quot;Seek Not to Tread the Sly Fox&#39;s Path&quot;\">\"Seek Not to Tread the Sly Fox's Path\"</a></td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"level\"><a href=\"/wiki/%22If_Truth_May_Be_Subject_to_Witness%22\" title=\"&quot;If Truth May Be Subject to Witness&quot;\">\"If Truth May Be Subject to Witness\"</a></td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t\n\t<section class=\"pi-item pi-panel pi-border-color wds-tabber\">\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tabs__wrapper\">\n\t\t\t\t<ul class=\"wds-tabs\">\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab wds-is-current\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tDescription\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t\t\t<li class=\"wds-tabs__tab\">\n\t\t\t\t\t\t\t<div class=\"wds-tabs__tab-label\">\n\t\t\t\t\t\t\t\tDetails\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\n\t\t\n\t\t\t<div class=\"wds-tab__content wds-is-current\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"description\">\n\t\n\t<div class=\"pi-data-value pi-font\">When attacks from the <span class=\"custom-tt-wrapper giw-extra-effect-wrapper toggle-tooltip mw-collapsible mw-made-collapsible mw-collapsed giw-collapsible\"><span class=\"mw-collapsible-toggle mw-collapsible-toggle-default mw-collapsible-toggle-collapsed giw-extra-effect toggle-tooltip\">Frostgrove Sanctuary</span><span class=\"mw-collapsible-content giw-extra-effect\" style=\"display:none\"><span class=\"giw-extra-effect-header\">Frostgrove Sanctuary</span><span class=\"giw-extra-effect-content\">A magical array that protects the Moonchanters and can be summoned by using the Elemental Skill Runo: Dawnless Rest of Karsikko.<br />The Frostgrove Sanctuary will follow the active character, dealing a single instance of <span class=\"text-dendro\"><b>AoE Dendro DMG</b></span> to opponents within the array every 2s. This DMG is considered Elemental Skill DMG.</span></span></span> summoned by her Elemental Skill <a href=\"/wiki/Runo:_Dawnless_Rest_of_Karsikko\" title=\"Runo: Dawnless Rest of Karsikko\">Runo: Dawnless Rest of Karsikko</a> hit opponents, Lauma will regain 4 Elemental <a href=\"/wiki/Energy\" title=\"Energy\">Energy</a>. This effect can be triggered once every 5s.</div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"utility1\">\n\t\n\t<div class=\"pi-data-value pi-font\"><b>Utility</b><ul><li><a href=\"/wiki/Energy_Generation\" class=\"mw-redirect\" title=\"Energy Generation\">Energy Generation</a></li></ul></div>\n</div>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n\n</section>\n</aside>\n\n<b>\"Nor Yearn for the Great Bear's Might\"</b> is <a href=\"/wiki/Lauma\" title=\"Lauma\">Lauma</a>'s <a href=\"/wiki/Level_4_Constellation\" class=\"mw-redirect\" title=\"Level 4 Constellation\">Level 4 Constellation</a>.\n<p class=\"mw-empty-elt\"></p>\n<h2><span class=\"mw-headline\" id=\"Other_Languages\">Other Languages</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a title=\"Sign in to edit\" class=\"mw-editsection-visualeditor\" data-tracking-label=\"log-in-edit-section\" data-action=\"edit-section\" href=\"https://auth.fandom.com/signin?redirect=https%3A%2F%2Fgenshin-impact.fandom.com%2Fwiki%2F%2522Nor_Yearn_for_the_Great_Bear%2527s_Might%2522%3Fveaction%3Dedit%26section%3D1&amp;uselang=en&amp;metadata=article-registration-edit-article-section\" data-auth-modal=\"signin\" data-testid=\"log-in-edit-section\" aria-label=\"Sign in to edit\"><svg class=\"wds-icon wds-icon-tiny\" aria-hidden=\"true\" focusable=\"false\"><use xlink:href=\"#wds-icons-pencil-tiny\"></use></svg></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"article-table\">\n<tbody><tr><th>Language</th><th>Official Name</th><th>Literal Meaning</th></tr><tr><td><b>English</b></td><td>\"Nor Yearn for the Great Bear's Might\"</td><td>&#8212;</td></tr><tr><td><b>Chinese<br /><small>(Simplified)</small></b></td><td><span lang=\"zh-Hans\">「汝、切莫贪恋巨熊的权柄」</span><br /><small><i><span lang=\"zh-rm\">\"Rǔ, Qièmò Tānliàn Jùxióng de Quánbǐng\"</span></i></small></td><td rowspan=\"2\">\"You, Never Cling to the Giant Bear's Authority\"</td></tr><tr><td><b>Chinese<br /><small>(Traditional)</small></b></td><td><span lang=\"zh-Hant\">「汝、切莫貪戀巨熊的權柄」</span><br /><small><i><span lang=\"zh-rm\">\"Rǔ, Qièmò Tānliàn Jùxióng de Quánbǐng\"</span></i></small></td></tr><tr><td><b>Japanese</b></td><td><span lang=\"ja\">「巨熊の力を</span> <span lang=\"ja\">恋い慕うこと勿れ」</span><br /><small><i>\"Kyoyuu no Chikara wo Koi Shitau Koto Nakare\"</i></small></td><td></td></tr><tr><td><b>Korean</b></td><td><span lang=\"ko\">「그대여</span>, <span lang=\"ko\">거대한</span> <span lang=\"ko\">곰의</span> <span lang=\"ko\">권력을</span> <span lang=\"ko\">탐하지</span> <span lang=\"ko\">말라」</span><br /><small><i>\"Geudaeyeo, Geodaehan Gomui Gwollyeogeul Tamhaji 