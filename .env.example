# Copy to .env (repo root) and fill in. .env is git-ignored — never commit it.
# Every setting below is read by rag/config.py; uncomment to override the default shown.

# --- Generation LLM (any OpenAI-compatible API). Default: GLM 5.3 Flash via OpenRouter (paid, ~$0.001 per query).
# All reported numbers use the default; a fallback model is for development only and changes the results.
LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=z-ai/glm-5.3-flash
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free   # fallback: free, no credits needed, rate-limited
# Same model straight from Z.ai (a GLM subscription). Used only when LLM_API_KEY is empty; the two routes never mix.
# ZAI_API_KEY=
# GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4   # default; only the coding endpoint works
# GLM_MODEL=glm-5.3-flash                            # default

# --- Retrieval. Default = B3 (hybrid + rerank over structure-aware chunks).
# RETRIEVER=hybrid          # bm25 | dense | hybrid      (B2 baseline: dense, RERANK=0, CHUNK_STRATEGY=A)
# RERANK=1                  # 1 | 0
# CHUNK_STRATEGY=B          # A (fixed 512/64) | B (structure-aware)
# K_POOL=20
# K_FINAL=5
# FUSION_DEPTH=30
# REFUSE_BELOW=0.52         # rerank-score refusal threshold, tuned on dev for the default reranker; 0 disables

# --- Models. Changing EMBED_MODEL needs re-chunking (its tokenizer sizes chunks) and re-indexing (new collection).
# EMBED_MODEL=BAAI/bge-m3
# RERANK_MODEL=BAAI/bge-reranker-v2-m3   # re-tune REFUSE_BELOW if you change it

# --- Chunk sizes (tokens)
# A_SIZE=512
# A_OVERLAP=64
# B_MAX=512

# --- Paths
# CORPUS_DIR=data/genshin
# ARTIFACTS_DIR=artifacts
# CHROMA_DIR=artifacts/chroma
# PORT=8800
